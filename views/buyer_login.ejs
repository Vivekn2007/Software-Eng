  <style>
    body { font-family: 'DM Sans', sans-serif; }

    /* Premium SaaS Ambient Background Blur Blobs */
    .blob {
      position: absolute;
      top: -100px; right: -50px;
      width: 550px; height: 550px;
      background: radial-gradient(circle at 50% 50%, rgba(124, 58, 237, 0.12) 0%, rgba(236, 72, 153, 0.04) 50%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
      filter: blur(60px);
    }
    .blob2 {
      position: absolute;
      bottom: -100px; left: -100px;
      width: 450px; height: 450px;
      background: radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.06) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
      filter: blur(60px);
    }

    /* Custom Checkbox accenting */
    input[type="checkbox"] {
      accent-color: #7C3AED;
      width: 15px;
      height: 15px;
      cursor: pointer;
    }

    /* Input Focus States */
    .field-input:focus {
      outline: none;
      border-color: #7C3AED;
      box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.06);
    }

    /* CRYSTAL-CLEAR PERFORMANCE LAYER:
      By isolating text rendering and properties, we avoid sub-pixel layout calculations.
      We use ease-in-out at 200ms for a highly premium, snappy response.
    */
    .premium-interactive-card {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      backface-visibility: hidden;
      transform: translate3d(0,0,0);
      will-change: box-shadow, border-color;
    }
    .UserExist{
      margin-top: 1rem;
      font-size : 1.5rem;
      font-family :'Times New Roman', Times, serif;

    }
  </style>
