            </a>
            <a class="px-4 py-2 text-sm font-medium text-white/70 hover:text-white hover:bg-white/5 rounded-lg cursor-pointer transition-all">
                Video Library
            </a>
            <a class="px-4 py-2 text-sm font-medium text-white/70 hover:text-white hover:bg-white/5 rounded-lg cursor-pointer transition-all">
                Publish
            </a>
        </div>

        <!-- Action Items shifted to the top right -->
        <div class="flex items-center gap-4 self-end md:self-auto">
            

            <button class="w-11 h-11 bg-white rounded-xl border border-[#E5E7EB] flex items-center justify-center shadow-sm relative cursor-pointer">
                <span class="w-2 h-2 rounded-full bg-[#EC4899] absolute top-3 right-3"></span>
                🔔
            </button>

            <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#7C3AED] to-[#EC4899] flex items-center justify-center text-white font-bold shadow-md select-none">
                M
            </div>
        </div>
    </div>

    <!-- ================= INNER CARD CONTENT ================= -->
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-3xl border border-[#E5E7EB] shadow-sm p-12 flex flex-col items-center justify-center text-center min-h-[340px]">
            
            <h2 class="text-2xl lg:text-3xl font-extrabold text-[#111111] tracking-tight">
                This membership has 0 published posts
            </h2>
            
            <p class="text-sm lg:text-base text-[#6B7280] font-medium mt-3 max-w-md">
                Posts allow you to provide private content to your customers
            </p>

     <a href="/membership/page3/" class="inline-block mt-8 px-9 py-3 bg-[#8B2CF5] hover:bg-[#7C22DD] text-white text-lg font-bold rounded-2xl shadow-md text-center transition-all cursor-pointer">
    Manage Posts
</a>

            <p class="text-sm font-semibold text-[#374151] mt-8">
    <a class="text-[#8B2CF5] hover:text-[#7C22DD] underline transition-all cursor-pointer">Read this article</a> to learn more about membership posts
</p>

        </div>
    </div>

