    document.addEventListener('DOMContentLoaded', () => {
      // 1. Fetch values safely from storage
      const savedName = localStorage.getItem('manch_storeName') || 'Learn With Ansh';
      const savedCategory = localStorage.getItem('manch_creatorCategory') || 'Education';
      const savedIdentity = localStorage.getItem('manch_identity') || 'JEE Mathematics Teacher';
      const savedLanguages = localStorage.getItem('manch_languages') || 'English, Hindi';
      const savedUsername = localStorage.getItem('manch_username') || 'learnwithansh';
      const savedBio = localStorage.getItem('manch_bio') || 'Your bio statement layout will display right here.';
      
      const defaultAvatar = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%237C3AED'><circle cx='12' cy='8' r='4'/><path d='M12 14c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/></svg>";
      const savedAvatar = localStorage.getItem('manch_avatar') || defaultAvatar;

      // 2. Format the custom URL link text safely
      const finalUrl = `manch.in/@${savedUsername.toLowerCase().replace(/[^a-z0-9_.]/g, '')}`;

      // 3. Inject explicitly by unique ID definitions into Live Preview Card
      document.getElementById('previewName').textContent = savedName;
      document.getElementById('previewIdentity').textContent = savedIdentity;
      document.getElementById('previewBio').textContent = savedBio;
      document.getElementById('cardUrlDisplay').textContent = finalUrl;
      
      const previewImgNode = document.getElementById('previewAvatarImg');
      if (previewImgNode) {
        previewImgNode.src = savedAvatar;
      }

      // 4. Inject explicitly into right summary info grid panels via updated specific IDs
      document.getElementById('summaryStoreName').textContent = savedName;
      document.getElementById('summaryLanguages').textContent = savedLanguages;
      document.getElementById('summaryIdentity').textContent = savedIdentity;
      document.getElementById('summaryCategory').textContent = savedCategory;
      const urlContainer = document.getElementById('summaryStoreUrl');
      if (urlContainer && urlContainer.querySelector('span')) {
        urlContainer.querySelector('span').textContent = finalUrl;
      }
    });

    const launchBtn = document.getElementById('launchStoreBtn');
    const launchText = document.getElementById('launchText');
    const launchArrow = document.getElementById('launchArrow');
    const launchSpinner = document.getElementById('launchSpinner');
    const button = document.querySelector("#AddProduct");
    const productText = document.getElementById('productText');
    const productArrow = document.getElementById('productArrow');
    const productSpinner = document.getElementById('productSpinner');

    button.addEventListener('click',()=>{
      button.disabled = true;
      productText.textContent = 'Deploying product instance...';
      if (productArrow) productArrow.classList.add('hidden');
      productSpinner.classList.remove('hidden');
      setTimeout(() => {
        alert('Redirecting to your digital product uploader handler...')
        window.location.href = '/addProduct';
      }, 2000);
    })
    launchBtn.addEventListener('click', (e) => {
      e.preventDefault();

      launchBtn.disabled = true;
      launchText.textContent = 'Deploying store instance...';
      if (launchArrow) launchArrow.classList.add('hidden');
      launchSpinner.classList.remove('hidden');

      setTimeout(() => {
        alert('🎉 Success! Your Manch digital storefront has been pushed onto live production routes!');
        window.location.href = '/dashboard';
      }, 2000);
    });
  </script>
</body>
</html>
