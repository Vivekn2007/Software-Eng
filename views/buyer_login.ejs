  <script>
    // Visibility toggle functionality logic for Password Field
    const pwdInput = document.getElementById('password');
    const pwdToggle = document.getElementById('pwdToggle');
    pwdToggle.addEventListener('click', () => {
      pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
    });

    // Form Event Listener Submission Flow with validation logic
    const loginForm = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    const submitText = document.getElementById('submitText');
    const submitSpinner = document.getElementById('submitSpinner');

    loginForm.addEventListener('submit', (e) => {
    
      
      // Hide active errors
      document.getElementById('emailError').classList.add('hidden');
      document.getElementById('passwordError').classList.add('hidden');
      document.getElementById('globalError').classList.add('hidden');
      
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      
      let valid = true;
      
      // Simple Regex match sequence check for Email input standard matching rules
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailPattern.test(email)) {
        document.getElementById('emailError').classList.remove('hidden');
        valid = false;
      }
      
      // Length check validation limiters
      if (password.length < 8) {
        document.getElementById('passwordError').classList.remove('hidden');
        valid = false;
      }
      
      // Simulated server submission routine
      if (valid) {
        submitBtn.disabled = true;
        submitText.textContent = 'Verifying...';
        submitSpinner.classList.remove('hidden');
        
        setTimeout(() => {
          submitBtn.disabled = false;
          submitText.textContent = 'Access My Files';
          submitSpinner.classList.add('hidden');
          alert('Success! Buyer profile field credentials verified.');
        }, 2000);
      }
    });
  </script>
