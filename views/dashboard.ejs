                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Total orders</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=order %></p>
                                <div class="smbox w-[5vw] h-[3vh] rounded-4xl bg-green-100 flex justify-center items-center not-md:w-[30vw]">
                                    <p class="text-[12px] text-green-700 font-serif">+<%=nord%> this week</p>
                                </div>
                            </div>
                            <div class="icon flex justify-end items-start h-[10vh]">
                                <div class="stat-icon-wrap bg-gradient-to-br from-[#6e52e8] to-[#f18e43] w-[5vmin] h-[5vmin] flex justify-center items-center not-md:w-[2.5rem] not-md:h-[2.5rem]">
                                    <i class="fa-solid fa-list text-2xl text-amber-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total views -->
                    <div
                        class="sales w-[15vw] h-[13vh] rounded-2xl bg-white border border-gray-200 flex justify-center items-center not-md:w-[90vw]">
                        <div class="w-[13vw] flex justify-between items-center not-md:w-[70vw]">
                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Total views</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=view %></p>
