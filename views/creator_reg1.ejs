  // Password Visibility Toggle Logic
  const pwdInput = document.getElementById('password');
  const pwdToggle = document.getElementById('pwdToggle');
  pwdToggle.addEventListener('click', () => {
    pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
  });

  // Client Side Validation Pipeline Ingestion Engine
  const form = document.getElementById('registrationForm');
  const submitBtn = document.getElementById('submitBtn');
  const submitText = document.getElementById('submitText');
  const submitArrow = document.getElementById('submitArrow');
  const submitSpinner = document.getElementById('submitSpinner');

  form.addEventListener('submit', (e) => {
    

    // Target elements
    const nameInput = document.getElementById('fullName');
    const emailInput = document.getElementById('email');
    const termsCheck = document.getElementById('termsAgreement');

    // Error message nodes
    const nameError = document.getElementById('nameError');
    const emailError = document.getElementById('emailError');
    const passwordError = document.getElementById('passwordError');
    const termsError = document.getElementById('termsError');

    // Reset error element configurations cleanly
    nameError.classList.add('hidden');
    emailError.classList.add('hidden');
    passwordError.classList.add('hidden');
    termsError.classList.add('hidden');

    let isValid = true;

    // 1. Validate Full Name Parameters
    if (nameInput.value.trim() === "") {
      nameError.classList.remove('hidden');
      isValid = false;
    }

    // 2. Validate Email Rail Strings via Standard Syntax Matrix
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(emailInput.value.trim())) {
      emailError.classList.remove('hidden');
      isValid = false;
    }

    // 3. Validate Password Depth Limiters
    if (pwdInput.value.length < 8) {
      passwordError.classList.remove('hidden');
      isValid = false;
    }

    // 4. Validate Registration Covenant Accord Tracking Checklist
    if (!termsCheck.checked) {
      termsError.classList.remove('hidden');
      isValid = false;
    }

    // If form state vector is completely integrated and valid, trigger processing UI pipeline
    if (isValid) {
      // De-authenticate interactive submission buttons to prevent collision overlaps
      submitBtn.disabled = true;
      submitText.textContent = "Setting up your studio space...";
      if (submitArrow) submitArrow.classList.add('hidden');
      submitSpinner.classList.remove('hidden');

      // Simulated data payload transport routine (Hook your actual backend handler endpoint fetch action right here!)
     // Simulated data payload transport routine (Hook your actual backend handler endpoint fetch action right here!)
      setTimeout(() => {
        // Redirect cleanly to your next registration page
        window.location.href = "/creator/signup/page2"; 
      }, 2000);
    }
  });
</script>
