                        <div class="img rounded-2xl "><img src="empty.webp"
                                class=" h-[12vh] w-[10vw] rounded-2xl not-md:w-[15vw] not-md:h-[7vmax] border-2 border-gray-400 "
                                name="img"></div>
                        <div class="detail">
                            <p class="text-purple-500 font-serif font-bold text-xl not-md:text-base ">
                                <%= name %>
                            </p>
                            <div class="sales flex text-base font-bold space-x-3 not-md:text-sm ">
                                <p class="">
                                    <%=view%> views,
                                </p>

                                <p class="">₹<%=sale%> sales</p>
                            </div>

                        </div>
                    </div>
