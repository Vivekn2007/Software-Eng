<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings | Manch</title>

</head>

<body class="bg-[#f5f3ff]">

<div class="flex min-h-screen not-md:block">

  <!-- ================= SIDEBAR PLACEHOLDER ================= -->
   <%- include('Navbar'); %> 
 

  <!-- ================= MAIN ================= -->
  <main class="flex-1 p-8">

    <!-- HEADER -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-[#111]">Settings</h1>
      <p class="text-gray-500 text-sm">Manage your account and store configuration</p>
    </div>

    <!-- ================= TABS ================= -->
    <div class="flex gap-6 border-b mb-6">

      <button onclick="switchTab('store', this)"
        class="tab-btn pb-2 border-b-2 border-[#7C3AED] text-[#7C3AED] font-medium">
        Store
      </button>

      <button onclick="switchTab('payment', this)"
        class="tab-btn pb-2 text-gray-500">
        Payment
      </button>

      <button onclick="switchTab('security', this)"
        class="tab-btn pb-2 text-gray-500">
        Security
      </button>

    </div>

    <!-- ================= TAB CONTENT ================= -->

    <!-- STORE TAB -->
    <div id="tab-store" class="tab-content">

      <div class="bg-white border rounded-xl p-6 space-y-4">

        <div>
          <label class="text-sm text-gray-700">Store Name</label>
          <input class="w-full border rounded-lg p-2 mt-1 focus:outline-none focus:ring-2 focus:ring-[#7C3AED]" 
                 type="text" value="Manch Store">
        </div>

        <div>
          <label class="text-sm text-gray-700">Language</label>
          <select class="w-full border rounded-lg p-2 mt-1">
            <option>English</option>
            <option>Hindi</option>
          </select>
        </div>

        <button class="bg-[#7C3AED] text-white px-5 py-2 rounded-lg">
          Save Changes
        </button>

      </div>

    </div>

    <!-- PAYMENT TAB -->
    <div id="tab-payment" class="tab-content hidden">

      <div class="bg-white border rounded-xl p-6 space-y-4">

        <div class="flex justify-between items-center border-b pb-3">
          <div>
            <p class="font-medium">Razorpay</p>
            <p class="text-sm text-gray-500">Connected</p>
          </div>
          <button class="text-sm text-[#7C3AED]">Manage</button>
        </div>

        <div class="flex justify-between items-center border-b pb-3">
          <div>
            <p class="font-medium">Stripe</p>
            <p class="text-sm text-gray-500">Not connected</p>
          </div>
          <button class="bg-[#7C3AED] text-white px-3 py-1 rounded-lg text-sm">
            Connect
          </button>
        </div>

      </div>

    </div>

    <!-- SECURITY TAB -->
    <div id="tab-security" class="tab-content hidden">

      <div class="bg-white border rounded-xl p-6 space-y-4">

        <div>
          <p class="font-medium">Password</p>
          <input type="password" class="w-full border rounded-lg p-2 mt-1">
        </div>

        <div class="flex items-center justify-between">
          <p class="text-sm text-gray-600">Two Factor Authentication</p>
          <input type="checkbox" class="w-5 h-5 accent-[#7C3AED]">
        </div>

        <button class="bg-[#7C3AED] text-white px-5 py-2 rounded-lg">
          Update Security
        </button>

      </div>

    </div>

  </main>
</div>

<!-- ================= JS TAB SWITCH ================= -->
<script>
function switchTab(tab, btn) {

  document.querySelectorAll('.tab-content')
    .forEach(el => el.classList.add('hidden'));

  document.getElementById('tab-' + tab)
    .classList.remove('hidden');

  document.querySelectorAll('.tab-btn')
    .forEach(b => {
      b.classList.remove('text-[#7C3AED]', 'border-[#7C3AED]');
      b.classList.add('text-gray-500');
    });

  btn.classList.add('text-[#7C3AED]', 'border-[#7C3AED]');
  btn.classList.remove('text-gray-500');
}
</script>

</body>
</html>