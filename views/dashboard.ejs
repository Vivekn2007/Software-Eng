                                        <button
                                            class="w-[6vmax] h-[3vmin] bg-gradient-to-br from-[#7c3aed] to-[#9333ea] text-white  rounded-2xl text-sm not-md:h-[12vmin] not-md:w-[12vmax] not-md:text-sm hover:cursor-pointer">Add
                                            new product</button>
                                    </div>
                                </div>


                            </div>
                            <iframe width="100%" src="/prodetails"
                                class="overflow-y-hidden overflow-x-hidden h-full"></iframe>
                        </div>
                    </div>

