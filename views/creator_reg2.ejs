              <p class="text-[11px] text-gray-400 font-medium mt-0.5 leading-normal">Digital products that help others</p>
            </div>
          </div>

          <div class="flex items-start gap-4 relative ml-12">
            <div class="w-11 h-11 rounded-2xl bg-[#EFEFFA] flex items-center justify-center text-[#7C3AED] text-lg border border-purple-100/40 shrink-0 shadow-xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="pt-0.5">
              <h4 class="text-sm font-bold text-[#111111]">Audience</h4>
              <p class="text-[11px] text-gray-400 font-medium mt-0.5 leading-normal">Build a community that trusts you</p>
            </div>
          </div>

          <div class="flex items-start gap-4 relative ml-18">
            <div class="w-11 h-11 rounded-2xl bg-[#FCE6F1] flex items-center justify-center text-[#EC4899] text-lg border border-pink-100/40 shrink-0 shadow-xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="pt-0.5">
              <h4 class="text-sm font-bold text-[#111111]">Business</h4>
              <p class="text-[11px] text-gray-400 font-medium mt-0.5 leading-normal">Grow, earn and live on your terms</p>
            </div>
          </div>
        </div>

      </div>

      <div class="h-4"></div>
    </div>

    <div class="lg:col-span-7 flex items-center justify-center w-full lg:-mt-0">
      <div class="premium-smooth-node w-full bg-white border border-gray-100 rounded-3xl shadow-xl shadow-gray-200/20 px-8 py-10 sm:px-10 sm:py-12">
        
        <div class="space-y-2 mb-8">
          <span class="text-[11px] font-extrabold text-[#7C3AED] uppercase tracking-[0.15em] block font-mono">Step 2 of 4</span>
          <h2 class="text-3xl font-bold text-[#111111] tracking-tight">Choose your creator profile.</h2>
          <p class="text-sm font-medium text-gray-400">This helps us personalise your experience and recommendations.</p>
          
          <div class="flex items-center justify-between relative pt-6 max-w-xl mx-auto">
            <div class="absolute h-0.5 left-6 right-6 top-[35px] bg-gray-100 z-0"></div>
            
            <div class="relative z-10 flex flex-col items-center gap-1.5">
              <div class="w-6 h-6 rounded-full bg-[#7C3AED] text-white font-bold text-[10px] flex items-center justify-center shadow-xs">✓</div>
              <span class="text-[10px] font-bold text-[#7C3AED]">Account</span>
            </div>
            <div class="relative z-10 flex flex-col items-center gap-1.5">
              <div class="w-6 h-6 rounded-full bg-[#7C3AED] text-white font-bold text-[10px] flex items-center justify-center shadow-xs">2</div>
              <span class="text-[10px] font-bold text-[#7C3AED]">Profile</span>
            </div>
            <div class="relative z-10 flex flex-col items-center gap-1.5">
              <div class="w-6 h-6 rounded-full bg-gray-50 text-gray-400 font-bold text-[10px] flex items-center justify-center border border-gray-200">3</div>
              <span class="text-[10px] font-medium text-gray-400">Setup</span>
            </div>
            <div class="relative z-10 flex flex-col items-center gap-1.5">
              <div class="w-6 h-6 rounded-full bg-gray-50 text-gray-400 font-bold text-[10px] flex items-center justify-center border border-gray-200">4</div>
              <span class="text-[10px] font-medium text-gray-400">Launch</span>
            </div>
          </div>
        </div>

        <form action="/creator/signup/page2" method="post" id="profileSelectionForm" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            
            <div class="relative">
              <input type="radio" name="creatorProfile" id="profEducator" value="educator" checked class="peer hidden profile-card-radio" />
              <label for="profEducator" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-green-50 flex items-center justify-center text-2xl mb-3">📚</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Educator</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Courses, Notes, Coaching Programs</p>
              </label>
            </div>

            <div class="relative">
              <input type="radio" name="creatorProfile" id="profCreator" value="creator" class="peer hidden profile-card-radio" />
              <label for="profCreator" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-purple-50 flex items-center justify-center text-2xl mb-3">🎥</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Creator</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Memberships & Premium Content</p>
              </label>
            </div>

            <div class="relative">
              <input type="radio" name="creatorProfile" id="profDeveloper" value="developer" class="peer hidden profile-card-radio" />
              <label for="profDeveloper" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center text-2xl mb-3">💻</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Developer</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Scripts, SaaS & Digital Tools</p>
              </label>
            </div>

            <div class="relative">
              <input type="radio" name="creatorProfile" id="profDesigner" value="designer" class="peer hidden profile-card-radio" />
              <label for="profDesigner" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-pink-50 flex items-center justify-center text-2xl mb-3">🎨</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Designer</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Templates, Assets & UI Kits</p>
              </label>
            </div>

            <div class="relative">
              <input type="radio" name="creatorProfile" id="profCoach" value="coach" class="peer hidden profile-card-radio" />
              <label for="profCoach" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-amber-50 flex items-center justify-center text-2xl mb-3">🧠</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Coach</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Consulting & Mentorship</p>
              </label>
            </div>

            <div class="relative">
              <input type="radio" name="creatorProfile" id="profOther" value="other" class="peer hidden profile-card-radio" />
              <label for="profOther" class="profile-card-label flex flex-col items-center text-center p-5 border border-gray-100 rounded-2xl cursor-pointer bg-white active:scale-[0.98] h-full premium-smooth-node">
                <div class="w-12 h-12 rounded-full bg-gray-50 flex items-center justify-center text-2xl mb-3">✨</div>
                <h4 class="text-sm font-bold text-[#111111] mb-1">Other</h4>
                <p class="text-[11px] text-gray-400 font-medium leading-normal">Create something unique</p>
              </label>
            </div>

          </div>
          <div class="space-y-3 pt-2">
            <!-- UPDATED: Assigned target tracking hooks to handle the text string transformations and loader nodes dynamically -->
            <button type="submit" id="submitBtn" class="w-full bg-[#0F1115] hover:bg-[#1C1E24] active:scale-[0.99] text-white font-bold text-sm py-4 rounded-xl transition-all duration-200 flex items-center justify-center gap-2.5 cursor-pointer">
               <span id="submitText">Let's Build My Space</span>
               <svg id="submitArrow" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
               <svg id="submitSpinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                 <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                 <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
               </svg>
            </button>
  
            <div class="text-center text-[11px] font-semibold text-gray-400 flex items-center justify-center gap-1.5">
              <span>🛡️</span> You can change this later anytime
            </div>
          </div>
        </form>

