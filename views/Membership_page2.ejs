<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Membership Details - Manch</title>

<!-- Tailwind CSS v4 CDN -->
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: #F8F9FA;
}
</style>
</head>

<body>

<div class="flex min-h-screen bg-[#f5f3ff] not-md:block">

<!-- ================= SIDEBAR ================= -->
<%- include('navbar.ejs'); %>

<!-- ================= MAIN CONTENT ================= -->
<main class="flex-1 p-8 lg:p-12 overflow-y-auto">

    <!-- ================= TOP NAVIGATION WRAPPER ================= -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-[#E5E7EB] pb-6 mb-12">
        
        <!-- Navbar tabs shifted to the top left -->
        <div class="bg-[#1A0533] rounded-xl px-4 py-2 flex flex-wrap gap-1 shadow-md">
            <a class="px-4 py-2 text-sm font-bold text-white bg-white/10 rounded-lg cursor-pointer border-b-2 border-[#7C3AED]">
                Posts
            </a>
            <a class="px-4 py-2 text-sm font-medium text-white/70 hover:text-white hover:bg-white/5 rounded-lg cursor-pointer transition-all">
                Settings
            </a>
            <a class="px-4 py-2 text-sm font-medium text-white/70 hover:text-white hover:bg-white/5 rounded-lg cursor-pointer transition-all">
                Pages
            </a>
            <a class="px-4 py-2 text-sm font-medium text-white/70 hover:text-white hover:bg-white/5 rounded-lg cursor-pointer transition-all">
