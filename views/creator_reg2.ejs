<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manch — Choose Your Creator Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
 <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />

  <style>
    body { font-family: 'DM Sans', sans-serif; }

    /* Profile Selection Interactive Border & Instant Transformation Only On Active Selection State (No Transition) */
    .profile-card-radio:checked + .profile-card-label {
      border-color: #7C3AED;
      background-color: rgba(124, 58, 237, 0.03);
      box-shadow: 0 12px 30px -5px rgba(124, 58, 237, 0.08);
      transform: scale(1.02);
    }

    /* Permanent rasterization fix layer matrix */
    .premium-smooth-node {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      backface-visibility: hidden;
      transform: translate3d(0, 0, 0);
    }
  </style>
</head>

<body class="bg-[#FAFAFB] min-h-screen flex flex-col justify-between antialiased relative overflow-x-hidden">

  <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:pl-4 lg:pr-16 pt-4 lg:pt-6 gap-10 lg:gap-14 items-start relative z-10">
    
    <div class="lg:col-span-5 flex flex-col justify-between h-full pt-1 pb-4 space-y-6 relative rounded-3xl overflow-hidden px-6 sm:px-12 lg:-ml-6 lg:-mt-4 bg-transparent">
      
