<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <style>
        /* ── Global ── */
        body {
            background: #f0edff;
        }

        /* ── Stat cards ── */
        .sales {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 2px 8px rgba(109, 40, 217, 0.08), 0 1px 3px rgba(0,0,0,0.05);
        }
        .sales:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(109, 40, 217, 0.15), 0 4px 10px rgba(0,0,0,0.07);
        }

        /* ── Stat icon badge ── */
        .stat-icon-wrap {
            box-shadow: 0 4px 12px rgba(110, 82, 232, 0.40);
            border-radius: 0.75rem;
        }

        /* ── Products panel ── */
        .prod {
            box-shadow: 0 4px 20px rgba(109, 40, 217, 0.09), 0 1px 4px rgba(0,0,0,0.05);
            transition: box-shadow 0.2s ease;
        }
        .prod:hover {
            box-shadow: 0 8px 32px rgba(109, 40, 217, 0.14);
        }

        /* ── Transaction card ── */
        .transaction {
            box-shadow: 0 4px 20px rgba(109, 40, 217, 0.09), 0 1px 4px rgba(0,0,0,0.05);
        }

        /* ── Individual transaction rows ── */
        .b2 {
            transition: background 0.15s ease;
        }
        .b2:hover {
            background: #faf8ff;
        }

        /* ── Transaction avatar ── */
        .logo {
            box-shadow: 0 2px 8px rgba(114, 86, 235, 0.35);
        }

        /* ── Quick actions card ── */
        .actions {
            box-shadow: 0 4px 20px rgba(109, 40, 217, 0.09), 0 1px 4px rgba(0,0,0,0.05);
        }

        /* ── Quick action tiles ── */
        .d1 {
            transition: transform 0.18s ease, box-shadow 0.18s ease;
            box-shadow: 0 1px 4px rgba(109, 40, 217, 0.07);
            cursor: pointer;
        }
        .d1:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(109, 40, 217, 0.14);
        }

        /* ── Add product button ── */
        button.add-btn {
            box-shadow: 0 3px 10px rgba(124, 58, 237, 0.40);
            transition: box-shadow 0.2s ease, transform 0.15s ease;
        }
        button.add-btn:hover {
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.52);
            transform: translateY(-1px);
        }

        /* ── Bell / avatar icon buttons ── */
        .noti {
            transition: box-shadow 0.2s ease, transform 0.15s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        }
        .noti:hover {
            box-shadow: 0 6px 18px rgba(109, 40, 217, 0.18);
            transform: translateY(-2px);
        }

        /* ── Head section subtle separator ── */
        .head {
            border-bottom: 1px solid rgba(109, 40, 217, 0.08);
        }
    </style>
</head>

<body class="flex not-md:block">
    <%- include('navbar.ejs'); %>
        <div class="main bg-[#f0edff] min-h-screen w-[80vw] not-md:w-[100vw] overflow-y-auto not-md:h-auto ">
