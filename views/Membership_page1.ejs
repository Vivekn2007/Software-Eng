<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Memberships - Manch</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #F8F9FA;
        }
    </style>
</head>

<body>

    <div class="flex min-h-screen bg-[#f5f3ff] not-md:block">

        <!-- ================= SIDEBAR ================= -->
        <%- include('navbar.ejs'); %>

            <!-- ================= MAIN CONTENT ================= -->
            <main class="flex-1 p-8 lg:p-12 overflow-y-auto">

                <!-- Header -->
                <form action="/membership/page1" method="post">
                    <div
                        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E5E7EB] pb-6 mb-10">

                        <div>

                            <p class="text-xs font-bold text-[#7C3AED] uppercase tracking-widest">
                                Membership Management
                            </p>

                            <h1 class="text-4xl font-extrabold text-[#111111] tracking-tight mt-1">
                                Memberships
                            </h1>

                            <p class="text-sm text-[#6B7280] font-medium mt-1">
                                Create and manage your membership products.
                            </p>

                        </div>

                        <div class="flex items-center gap-4">

                            <button
                                class="w-11 h-11 bg-white rounded-xl border border-[#E5E7EB] flex items-center justify-center shadow-sm relative">
                                <span class="w-2 h-2 rounded-full bg-[#EC4899] absolute top-3 right-3"></span>
                                🔔
                            </button>

                            <div
                                class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#7C3AED] to-[#EC4899] flex items-center justify-center text-white font-bold shadow-md">
                                M
                            </div>

                        </div>

                    </div>

                    <!-- Membership Card -->
                    <div class="max-w-4xl mx-auto">

                        <div class="bg-white rounded-3xl border border-[#E5E7EB] shadow-sm p-10">

                            <div class="text-center mb-8">

                                <h2 class="text-3xl font-extrabold text-[#111111]">
                                    Add New Membership
                                </h2>

                                <p class="text-sm text-[#6B7280] mt-3">
                                    To get started, choose the membership title —
                                    you can change it later.
                                </p>

                            </div>

                            <div>

                                <label class="block text-sm font-bold text-[#374151] mb-3">
                                    Membership Title
                                </label>

                                <input id="membership-title" type="text" name="title"
                                    placeholder="Type membership title here..."
                                    class="w-full h-12 px-4 rounded-xl border border-[#E5E7EB] bg-[#FAFAFA] focus:outline-none focus:border-[#7C3AED] focus:bg-white transition-all">

                            </div>

                            <div class="flex justify-end mt-8">
                                <input type="submit" id="add-membership-btn" value="Add Membership" disabled
                                    class="opacity-50 cursor-not-allowed inline-block px-9 py-3.5 rounded-xl bg-gradient-to-r from-[#7C3AED] to-[#9333EA] text-white font-bold text-center shadow-lg transition-all duration-300 transform ease-out">
                                    
                                
                            </div>

                        </div>

                    </div>
                </form>
    </div>

    </main>

    </div>

    <script>
        const titleInput = document.getElementById('membership-title');
        const addBtn = document.getElementById('add-membership-btn');

        titleInput.addEventListener('input', () => {
            // Check if the input contains non-whitespace text
            if (titleInput.value.trim().length > 0) {
                // Enable button and apply the big size transition layout
                addBtn.removeAttribute('disabled');
                addBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                addBtn.classList.add('hover:scale-108', 'active:scale-98', 'cursor-pointer');
            } else {
                // Disable button and strip the hover animations
                addBtn.setAttribute('disabled', 'true');
                addBtn.classList.add('opacity-50', 'cursor-not-allowed');
                addBtn.classList.remove('hover:scale-108', 'active:scale-98', 'cursor-pointer');
            }
        });

        // Redirect to member2.html when clicked
        addBtn.addEventListener('click', () => {
            if (!addBtn.hasAttribute('disabled')) {
                window.location.href = '/membership/page2';
            }
        });
    </script>
</body>

</html>