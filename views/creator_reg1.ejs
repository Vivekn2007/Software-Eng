    </div>
    <!-- Error Node -->
    <p id="nameError" class="hidden text-[11px] text-red-500 mt-1 ml-1 font-medium">Please enter your full name.</p>
  </div>

  <!-- Email Input -->
  <div>
    <label for="email" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Email Address</label>
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs">✉</span>
      <input type="email" name="email" id="email" placeholder="Enter your email address" required class="field-input w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm text-[#111111] placeholder-gray-400 bg-white transition-all font-medium" />
    </div>
    <!-- Error Node -->
    <p id="emailError" class="hidden text-[11px] text-red-500 mt-1 ml-1 font-medium">Please enter a valid email address.</p>
  </div>

  <!-- Password Input -->
  <div>
    <label for="password" class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">Password</label>
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs">🔒</span>
      <input type="password" name="password" id="password" placeholder="Create a strong password" required class="field-input w-full pl-10 pr-10 py-2.5 border border-gray-200 rounded-xl text-sm text-[#111111] placeholder-gray-400 bg-white transition-all font-medium" />
      <button type="button" id="pwdToggle" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors cursor-pointer text-xs">👁</button>
    </div>
    <!-- Error Node -->
    <p id="passwordError" class="hidden text-[11px] text-red-500 mt-1 ml-1 font-medium">Password must be at least 8 characters long.</p>
  </div>

  <!-- Terms Agreement Checkbox -->
  <div class="flex items-start gap-2.5 text-sm pt-1 select-none">
    <input type="checkbox" id="termsAgreement" required class="mt-0.5" />
    <label for="termsAgreement" class="text-xs text-gray-500 font-medium cursor-pointer leading-normal">
      I agree to the <a href="#" class="font-bold text-[#7C3AED] hover:underline">Terms of Service</a> and <a href="#" class="font-bold text-[#7C3AED] hover:underline">Privacy Policy</a>.
    </label>
  </div>
  <!-- Error Node -->
  <p id="termsError" class="hidden text-[11px] text-red-500 mt-1 ml-1 font-medium">You must accept the terms to proceed.</p>

  <!-- Submit Button -->
  
  <button type="submit" id="submitBtn" class="w-full bg-[#0F1115] hover:bg-[#1C1E24] active:scale-[0.99] text-white font-bold text-sm py-3.5 rounded-xl transition-all duration-200 flex items-center justify-center gap-2.5 cursor-pointer mt-3">
    <span id="submitText">Begin My Journey</span>
    <span id="submitArrow" class="text-xs">→</span>
    <!-- Spinner Node for loading states -->
    <svg id="submitSpinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  </button>
</form>
