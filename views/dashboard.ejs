                                        <div class="logo h-[5vmin] w-[5vmin] not-md:w-[8vmin] not-md:h-[8vmin] rounded-[50%] bg-gradient-to-br from-[#7256eb] to-[#eb56ab] flex justify-center items-center"><p class="text-base text-white">V</p></div>
                                        <div class="detail ">
                                            <p class="text-sm text-black">Vivek Narayan</p>
                                            <p class="text-[10px] text-gray-400">5 hours ago</p>
                                        </div>
                                    </div>
                                    <div class="amount flex justify-center items-center space-x-2 not-md:space-x-7">
                                        <p class="text-sm text-black">₹75</p>
                                        <div class="w-[2vw] h-[2vh] bg-green-300 rounded-2xl flex justify-center items-center not-md:w-[10vw]">
                                            <p class="text-[11px] text-green-900">Paid</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="b2 flex justify-center items-center border-b border-gray-400">
                                <div class="w-[16vw] h-[6vh]  flex justify-between items-center not-md:w-[75vw]">
                                    <div class="w-[9vw] flex justify-between items-center not-md:w-[36vw]">
                                        <div class="logo h-[5vmin] w-[5vmin] not-md:w-[8vmin] not-md:h-[8vmin] rounded-[50%] bg-gradient-to-br from-[#7256eb] to-[#eb56ab] flex justify-center items-center"><p class="text-base text-white">V</p></div>
                                        <div class="detail ">
                                            <p class="text-sm text-black">Vivek Narayan</p>
                                            <p class="text-[10px] text-gray-400">5 hours ago</p>
                                        </div>
                                    </div>
                                    <div class="amount flex justify-center items-center space-x-2 not-md:space-x-7">
                                        <p class="text-sm text-black">₹75</p>
                                        <div class="w-[2vw] h-[2vh] bg-green-300 rounded-2xl flex justify-center items-center not-md:w-[10vw]">
                                            <p class="text-[11px] text-green-900">Paid</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="b2 flex justify-center items-center border-b border-gray-400">
                                <div class="w-[16vw] h-[6vh]  flex justify-between items-center not-md:w-[75vw]">
                                    <div class="w-[9vw] flex justify-between items-center not-md:w-[36vw]">
                                        <div class="logo h-[5vmin] w-[5vmin] not-md:w-[8vmin] not-md:h-[8vmin] rounded-[50%] bg-gradient-to-br from-[#7256eb] to-[#eb56ab] flex justify-center items-center"><p class="text-base text-white">V</p></div>
                                        <div class="detail ">
                                            <p class="text-sm text-black">Vivek Narayan</p>
                                            <p class="text-[10px] text-gray-400">5 hours ago</p>
                                        </div>
                                    </div>
                                    <div class="amount flex justify-center items-center space-x-2 not-md:space-x-7">
                                        <p class="text-sm text-black">₹75</p>
                                        <div class="w-[2vw] h-[2vh] bg-green-300 rounded-2xl flex justify-center items-center not-md:w-[10vw]">
                                            <p class="text-[11px] text-green-900">Paid</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="b3 h-[6vh] flex justify-center items-center">
                                <a class="text-base text-[#9333ea]">View all 10 Transactions→</a>
                            </div>

                        </div>

                        <div class="actions w-[20vw] h-[20vh] bg-white rounded-2xl border border-gray-300 not-md:w-[90vw]">
                            <div class="w-[20vw] h-[5vh] flex justify-center items-center not-md:w-[90vw]">
                                <div class="w-[17vw] h-[5vh] flex justify-start items-center not-md:w-[80vw]">
                                    <p class="text-base text-black font-serif">Quick Actions</p>
                                </div>
                                
                            </div>
                            <div class="w-[20vw] flex justify-center items-center h-[14vh] not-md:w-[90vw]">
                                <div class="w-[17vw] flex flex-wrap justify-center items-center gap-1.5 not-md:w-[80vw] ">
                                    <div class="d1 h-[5vh] w-[8vw] bg-[#f5f3ff] rounded-xl flex items-end justify-start not-md:w-[35vw]">
                                        <a class="text-[13px] text-black  ml-3 mb-2 font-bold">Add product</a>
                                    </div>
                                    <div class="d1 h-[5vh] w-[8vw] bg-[#fff7ed] rounded-xl flex items-end justify-start not-md:w-[35vw]">
