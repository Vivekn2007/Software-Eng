<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>

<body class="flex not-md:block">
    <%- include('navbar.ejs'); %>
        <div class="main bg-[#f5f3ff] min-h-screen w-[80vw] not-md:w-[100vw] overflow-y-auto not-md:h-auto ">
            <div class="head w-[80vw] h-[15vh] flex justify-center items-center not-md:w-[100vw] ">
                <div class="inner flex justify-between items-center w-[75vw] not-md:w-[90vw]">
                    <div class="details">
                        <p class="text-2xl text-[#1A0533] font-serif font-bold ">Hello <%=name %> 👋</p>
                        <p class="text-sm text-gray-500 font-sans">Here's what's happening with your store today.</p>
                    </div>
                    <div class="right flex justify-center items-center space-x-3 ">
                        <div
                            class="noti w-[5vmin] h-[5vmin] flex justify-center items-center rounded-2xl border-2 border-black  not-md:hidden hover:cursor-pointer">
                            <i class="fa-solid fa-bell text-2xl   "></i>
                        </div>
                        <div
                            class="noti w-[5vmin] h-[5vmin]  rounded-[50%] flex justify-center items-center bg-gradient-to-br from-[#9634f2] to-[#f8a10c] not-md:hidden hover:cursor-pointer">
                            <p class="text-2xl text-white font-serif">
                                <%=symbol%>
                            </p>
                        </div>


                    </div>
                </div>
            </div>

            <div class="saleDet w-[80vw] h-[15vh] flex justify-center items-center not-md:w-[100vw] not-md:h-[60vh]">
                <div
                    class="w-[80vw] h-[15vh] flex justify-evenly items-center  not-md:block not-md:w-[90vw] not-md:space-y-3 not-md:h-[60vh]">
                    <div
                        class="sales w-[15vw] h-[13vh] rounded-2xl bg-white border border-gray-300 flex justify-center items-center not-md:w-[90vw] ">
                        <div class="w-[13vw] flex justify-between items-center not-md:w-[70vw] ">
                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Sales this month</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=sales %>
                                </p>
                                <div
                                    class="smbox w-[5vw] h-[3vh] rounded-4xl bg-amber-200 flex justify-center items-center not-md:w-[30vw]">
                                    <p class="text-[12px] text-orange-400 font-serif">This month</p>
                                </div>
                            </div>
                            <div class="icon flex justify-end items-start h-[10vh]">
                                <div
                                    class="bg-gradient-to-br from-[#6e52e8] to-[#f18e43] w-[5vmin] h-[5vmin] rounded-xl flex justify-center items-center not-md:w-[2.5rem] not-md:h-[2.5rem]">
                                    <i class="fa-solid fa-bag-shopping text-2xl text-amber-50"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div
                        class="sales w-[15vw] h-[13vh] rounded-2xl bg-white border border-gray-300 flex justify-center items-center not-md:w-[90vw] ">
                        <div class="w-[13vw] flex justify-between items-center not-md:w-[70vw] ">
                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Total orders</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=order %>
                                </p>
                                <div
                                    class="smbox w-[5vw] h-[3vh] rounded-4xl bg-green-500 flex justify-center items-center not-md:w-[30vw]">
                                    <p class="text-[12px] text-green-800 font-serif">+<%=nord%> this week</p>
                                </div>
                            </div>
                            <div class="icon flex justify-end items-start h-[10vh]">
                                <div
                                    class="bg-gradient-to-br from-[#6e52e8] to-[#f18e43] w-[5vmin] h-[5vmin] rounded-xl flex justify-center items-center not-md:w-[2.5rem] not-md:h-[2.5rem]">
                                    <i class="fa-solid fa-list text-2xl text-amber-50"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div
                        class="sales w-[15vw] h-[13vh] rounded-2xl bg-white border border-gray-300 flex justify-center items-center not-md:w-[90vw] ">
                        <div class="w-[13vw] flex justify-between items-center not-md:w-[70vw] ">
                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Total views</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=view %>
                                </p>
                                <div
                                    class="smbox w-[5vw] h-[3vh] rounded-4xl bg-green-500 flex justify-center items-center not-md:w-[30vw]">
                                    <p class="text-[12px] text-green-800 font-serif">
                                        <%=perc%>%
                                    </p>
                                </div>
                            </div>
                            <div class="icon flex justify-end items-start h-[10vh]">
                                <div
                                    class="bg-gradient-to-br from-[#6e52e8] to-[#f18e43] w-[5vmin] h-[5vmin] rounded-xl flex justify-center items-center not-md:w-[2.5rem] not-md:h-[2.5rem]">
                                    <i class="fa-solid fa-eye text-2xl text-amber-50"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div
                        class="sales w-[15vw] h-[13vh] rounded-2xl bg-white border border-gray-300 flex justify-center items-center not-md:w-[90vw] ">
                        <div class="w-[13vw] flex justify-between items-center not-md:w-[70vw] ">
                            <div class="det">
                                <p class="text-[12px] text-gray-500 font-sans">Products</p>
                                <p class="text-2xl text-[#1A0533] font-serif font-bold">₹<%=product %>
                                </p>
                                <div
                                    class="smbox w-[5vw] h-[3vh] rounded-4xl bg-amber-200 flex justify-center items-center not-md:w-[30vw]">
                                    <p class="text-[12px] text-orange-400 font-serif">
                                        <%=publish%> published
                                    </p>
                                </div>
                            </div>
                            <div class="icon flex justify-end items-start h-[10vh]">
                                <div
                                    class="bg-gradient-to-br from-[#6e52e8] to-[#f18e43] w-[5vmin] h-[5vmin] rounded-xl flex justify-center items-center not-md:w-[2.5rem] not-md:h-[2.5rem]">
                                    <i class="fa-solid fa-cart-shopping text-2xl text-amber-50"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="products w-[80vw] flex justify-center items-center mt-5 not-md:w-[100vw] ">
                <div class="w-[73vw] flex justify-between items-center not-md:block not-md:w-[90vw] not-md:space-y-4">
                    <div class="w-[73vw] not-md:w-[90vw] ">
                        <div
                            class="prod w-[50vw] h-[40vh] bg-white rounded-2xl border border-gray-300 overflow-x-hidden overflow-y-scroll not-md:w-[90vw] ">
                            <div
                                class="head flex h-[6vh] w-[50vw] justify-center items-center border-b border-gray-300 not-md:w-[90vw] not-md:h-[18vmin]">
                                <div class="inner  flex w-[40vw] justify-between items-center not-md:w-[70vw]">
